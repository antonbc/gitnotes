{
  "name": "gitnotes",
  "version": "0.1.0",
  "description": "Local-first notes for Markdown, Typst, and Git-backed vaults",
  "type": "module",
  "homepage": "https://antonbc.github.io/gitnotes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonbc/gitnotes.git"
  },
  "bugs": {
    "url": "https://github.com/antonbc/gitnotes/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "site:dev": "vite --config site/site.config.js",
    "site:build": "vite build --config site/site.config.js",
    "site:preview": "vite preview --config site/site.config.js",
    "lint": "npm run check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm test && npm run build && npm run site:build && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "scripts/tauri.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@lucide/svelte": "^1.17.0",
    "@replit/codemirror-vim": "6.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "2.11.0",
    "fuse.js": "7.4.2",
    "katex": "0.17.0",
    "markdown-it": "14.2.0",
    "markdown-it-task-lists": "2.1.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.63.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "25.9.2",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
